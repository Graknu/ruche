<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Mon appli{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body class="bg-body-tertiary">

    {% include '_partials/_sidebar.html.twig' %}

    <div class="app-main d-flex flex-column min-vh-100">
        {% include '_partials/_topbar.html.twig' %}

        <main class="flex-grow-1 p-3 p-lg-4">
            <h1 class="h3 mb-4">{% block page_title %}{% endblock %}</h1>
            {% block body %}{% endblock %}
        </main>
    </div>

</body>
</html>